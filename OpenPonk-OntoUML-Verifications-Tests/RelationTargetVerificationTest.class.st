"
I represent tests for RelationTargetVerification.
"
Class {
	#name : 'RelationTargetVerificationTest',
	#superclass : 'AbstractVerificationTest',
	#category : 'OpenPonk-OntoUML-Verifications-Tests-Verification-Classes',
	#package : 'OpenPonk-OntoUML-Verifications-Tests',
	#tag : 'Verification-Classes'
}

{ #category : 'constants' }
RelationTargetVerificationTest >> getExpectedGetValidTargetsForFromCollection [

	^ 'validTargetsForCharacterization
	"I return association between OntoUML relationship stereotype Characterization and its allowed targets.
	I am generated by getValidTargetsFor:FromCollection: and tested by testGetValidTargetsForFromCollection."

	^ OntoUMLCharacterization -> { OntoUMLSubKind. OntoUMLTest. OntoUMLMock. }.'
]

{ #category : 'constants' }
RelationTargetVerificationTest >> getExpectedUpdatedMessageCode [
	^'validTargets
	"I return dictionary containing collections of allowed targets for each OntoUML relationship stereotype.
	Code generated by getUpdatedMessageCode."

	| result |
	result := Dictionary new.
	result add: self validTargetsForCharacterization.
	result add: self validTargetsForMediation.
	result add: self validTargetsForTest.
	^ result.'.
]

{ #category : 'constants' }
RelationTargetVerificationTest >> getMockVerificationUpdater [
	| mockUpdater |
	mockUpdater := OntoUMLVerificationUpdater new.
	mockUpdater relationshipSpecifications: { MockOntoUMLRelationshipStereotypeYaml new name: 'Characterization'. MockOntoUMLRelationshipStereotypeYaml new name: 'Mediation'. MockOntoUMLRelationshipStereotypeYaml new name: 'Test'. }.
 	^ mockUpdater.
]

{ #category : 'constants' }
RelationTargetVerificationTest >> getTestedClass [
	^ RelationTargetVerification.
]

{ #category : 'constants' }
RelationTargetVerificationTest >> getVerifiedClass [
	^ OPUMLAssociation.
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testCanVerify [
	self canVerifyTest.
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testGetUpdatedMessageCode [
	| mockVerificationUpdater updatedCode |
	mockVerificationUpdater := self getMockVerificationUpdater.
	updatedCode := self getTestedClass getUpdatedMessageCode: mockVerificationUpdater.
	self assert: updatedCode equals: self getExpectedUpdatedMessageCode.
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testGetValidTargetsForFromCollection [
	| updatedCode |
	updatedCode := self getTestedClass getValidTargetsFor: 'Characterization' fromCollection: { 'SubKind'. 'Test'. 'Mock'.}.
	self assert: updatedCode equals: self getExpectedGetValidTargetsForFromCollection.
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testInvalidModel [

	| mode quality association model result message |
	mode := OPUMLClass new.
	mode applyStereotype: OntoUMLMode new.
	quality := OPUMLClass new.
	quality applyStereotype: OntoUMLQuality new.
	association := self createAssociationFrom: quality to: mode.
	association applyStereotype: OntoUMLContainment new.
	model := {
		         mode.
		         quality.
		         association }.
	result := VerificationResults new.
	result addResults: (RelationTargetVerification verify: association withModel: model).
	self assert: result results size equals: 1.
	message := result results anyOne.
	self assert: message class identicalTo: VerificationMessageError.
	self assert: message objectReference identicalTo: association.
	self assert: message verification class identicalTo: RelationTargetVerification.
	self assert: message messageText equals: 'OntoUMLMode cannot be target of OntoUMLContainment association'.
	self
		assert: message documentationReference
		equals: 'https://ontouml.readthedocs.io/en/latest/relationships/aggregations/containment/index.html'
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testNew [
	self newTest.
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testValidModel [

	| mode quantity association model result |
	mode := OPUMLClass new.
	mode applyStereotype: OntoUMLMode new.
	quantity := OPUMLClass new.
	quantity applyStereotype: OntoUMLQuantity new.
	association := self createAssociationFrom: mode to: quantity.
	association applyStereotype: OntoUMLContainment new.
	model := {
		         mode.
		         quantity.
		         association }.
	result := VerificationResults new.
	result addResults: (RelationTargetVerification verify: association withModel: model).
	self assertEmpty: result results
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testValidTargets [

	| dictionary |
	dictionary := self getTestedClass validTargets.
	self assert: dictionary class identicalTo: Dictionary.
	self assertCollection: dictionary keys hasSameElements: {
			OntoUMLCharacterization.
			OntoUMLComponentOf.
			OntoUMLContainment.
			OntoUMLDerivation.
			OntoUMLDomainFormal.
			OntoUMLMaterial.
			OntoUMLMediation.
			OntoUMLMemberOf.
			OntoUMLSubCollectionOf.
			OntoUMLSubQuantityOf }.
	self assert: (dictionary at: OntoUMLDomainFormal) class identicalTo: Array.
	self denyEmpty: (dictionary at: OntoUMLDomainFormal)
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testValidTargetsFor [

	| methodList associations |
	methodList := (RelationTargetVerification class localMethods collect: [ :method | method selector ]) select: [ :methodName |
		              methodName matchesRegex: 'validTargetsFor.*' ].
	self denyEmpty: methodList.
	associations := methodList collect: [ :methodName |
			                | association |
			                association := RelationTargetVerification class >> methodName asSymbol valueWithReceiver: nil arguments: #(  ).
			                self assert: association class identicalTo: Association.
			                self
				                assert: association key isClass
				                description: 'Relation target specification key must be a stereotype class'.
			                self assert: association value class identicalTo: Array.
			                association ].
	self assertCollection: (associations collect: #key) hasSameElements: self getTestedClass validTargets keys
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testVerifiedClass [
	self verifiedClassTest.
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testVerifyObjectWithModel [
	self testInvalidModel.
	self testValidModel.
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testVerifySkipsAssociationWithoutStereotype [

	| mode quality association model |
	mode := self createClass: 'Symptom' withStereotype: OntoUMLMode.
	quality := self createClass: 'Weight' withStereotype: OntoUMLQuality.
	association := self createAssociationFrom: quality to: mode.
	model := {
		         mode.
		         quality.
		         association }.
	self assertEmpty: (RelationTargetVerification verify: association withModel: model)
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testVerifySkipsEndWithoutStereotype [

	| quantity unstereotypedClass association model |
	quantity := self createClass: 'Water' withStereotype: OntoUMLQuantity.
	unstereotypedClass := OPUMLClass new.
	association := self createAssociationFrom: quantity to: unstereotypedClass with: OntoUMLContainment new.
	model := {
		         quantity.
		         unstereotypedClass.
		         association }.
	self assertEmpty: (RelationTargetVerification verify: association withModel: model)
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testVerifySubKindWithValidAndInvalidParent [

	| quantity kind validSubKind invalidSubKind container genValid genInvalid validAssociation invalidAssociation model |
	quantity := self createClass: 'Liquid' withStereotype: OntoUMLQuantity.
	kind := self createClass: 'Person' withStereotype: OntoUMLKind.
	validSubKind := self createClass: 'Wine' withStereotype: OntoUMLSubKind.
	invalidSubKind := self createClass: 'Adult' withStereotype: OntoUMLSubKind.
	container := self createClass: 'Bottle' withStereotype: OntoUMLKind.
	genValid := self createGeneralizationFor: quantity withSpecific: validSubKind.
	genInvalid := self createGeneralizationFor: kind withSpecific: invalidSubKind.
	validAssociation := self createAssociationFrom: container to: validSubKind with: OntoUMLContainment new.
	invalidAssociation := self createAssociationFrom: container to: invalidSubKind with: OntoUMLContainment new.
	model := {
		         quantity.
		         kind.
		         validSubKind.
		         invalidSubKind.
		         container.
		         genValid.
		         genInvalid.
		         validAssociation.
		         invalidAssociation }.
	self assertEmpty: (RelationTargetVerification verify: validAssociation withModel: model).
	self assert: (RelationTargetVerification verify: invalidAssociation withModel: model) size equals: 1
]

{ #category : 'tests' }
RelationTargetVerificationTest >> testVerifyWithModel [
	self testInvalidModel.
	self testValidModel.
]

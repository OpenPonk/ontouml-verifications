"
I represent tests for RelationSourceVerification.
"
Class {
	#name : 'RelationSourceVerificationTest',
	#superclass : 'AbstractVerificationTest',
	#category : 'OpenPonk-OntoUML-Verifications-Tests-Verification-Classes',
	#package : 'OpenPonk-OntoUML-Verifications-Tests',
	#tag : 'Verification-Classes'
}

{ #category : 'constants' }
RelationSourceVerificationTest >> getExpectedGetValidSourcesForFromCollection [
	^'validSourcesForCharacterization
	"I return association between OntoUML relationship stereotype Characterization and its allowed sources.
	I am generated by getValidSourcesFor:FromCollection: and tested by testGetValidSourcesForFromCollection."

	^ OntoUMLCharacterization -> { OntoUMLSubKind. OntoUMLTest. OntoUMLMock. }.'.
]

{ #category : 'constants' }
RelationSourceVerificationTest >> getExpectedUpdatedMessageCode [
	^ 'validSources
	"I return dictionary containing collections of allowed sources for each OntoUML relationship stereotype.
	Code generated by getUpdatedMessageCode."

	| result |
	result := Dictionary new.
	result add: self validSourcesForCharacterization.
	result add: self validSourcesForMediation.
	result add: self validSourcesForTest.
	^ result.'.
]

{ #category : 'constants' }
RelationSourceVerificationTest >> getMockVerificationUpdater [
	| mockUpdater |
	mockUpdater := OntoUMLVerificationUpdater new.
	mockUpdater relationshipSpecifications: { MockOntoUMLRelationshipStereotypeYaml new name: 'Characterization'. MockOntoUMLRelationshipStereotypeYaml new name: 'Mediation'. MockOntoUMLRelationshipStereotypeYaml new name: 'Test'. }.
 	^ mockUpdater.
]

{ #category : 'constants' }
RelationSourceVerificationTest >> getTestedClass [
	^ RelationSourceVerification.
]

{ #category : 'constants' }
RelationSourceVerificationTest >> getVerifiedClass [
	^ OPUMLAssociation.
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testCanVerify [
	self canVerifyTest.
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testGetUpdatedMessageCode [
	| mockVerificationUpdater updatedCode |
	mockVerificationUpdater := self getMockVerificationUpdater.
	updatedCode := self getTestedClass getUpdatedMessageCode: mockVerificationUpdater.
	self assert: updatedCode equals: self getExpectedUpdatedMessageCode.
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testGetValidSourcesForFromCollection [
	| updatedCode |
	updatedCode := self getTestedClass getValidSourcesFor: 'Characterization' fromCollection: { 'SubKind'. 'Test'. 'Mock'.}.
	self assert: updatedCode equals: self getExpectedGetValidSourcesForFromCollection.
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testInvalidModel [

	| collective quality association model result message |
	collective := OPUMLClass new.
	collective applyStereotype: OntoUMLCollective new.
	quality := OPUMLClass new.
	quality applyStereotype: OntoUMLQuality new.
	association := self createAssociationFrom: quality to: collective.
	association applyStereotype: OntoUMLMemberOf new.
	model := {
		         collective.
		         quality.
		         association }.
	result := VerificationResults new.
	result addResults: (RelationSourceVerification verify: association withModel: model).
	self assert: result results size equals: 1.
	message := result results anyOne.
	self assert: message class identicalTo: VerificationMessageError.
	self assert: message objectReference identicalTo: association.
	self assert: message verification class identicalTo: RelationSourceVerification.
	self assert: message messageText equals: 'OntoUMLQuality cannot be source of OntoUMLMemberOf association'.
	self
		assert: message documentationReference
		equals: 'https://ontouml.readthedocs.io/en/latest/relationships/aggregations/memberOf/index.html'
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testNew [
	self newTest.
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testValidModel [

	| collective quality association model result |
	collective := OPUMLClass new.
	collective applyStereotype: OntoUMLCollective new.
	quality := OPUMLClass new.
	quality applyStereotype: OntoUMLQuality new.
	association := self createAssociationFrom: collective to: quality.
	association applyStereotype: OntoUMLMemberOf new.
	model := {
		         collective.
		         quality.
		         association }.
	result := VerificationResults new.
	result addResults: (RelationSourceVerification verify: association withModel: model).
	self assertEmpty: result results
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testValidSources [

	| dictionary |
	dictionary := self getTestedClass validSources.
	self assert: dictionary class identicalTo: Dictionary.
	self assertCollection: dictionary keys hasSameElements: {
			OntoUMLCharacterization.
			OntoUMLComponentOf.
			OntoUMLContainment.
			OntoUMLDerivation.
			OntoUMLDomainFormal.
			OntoUMLMaterial.
			OntoUMLMediation.
			OntoUMLMemberOf.
			OntoUMLSubCollectionOf.
			OntoUMLSubQuantityOf }.
	self assert: (dictionary at: OntoUMLDomainFormal) class identicalTo: Array.
	self denyEmpty: (dictionary at: OntoUMLDomainFormal)
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testValidSourcesFor [

	| methodList associations |
	methodList := (RelationSourceVerification class localMethods collect: [ :method | method selector ]) select: [ :methodName |
		              methodName matchesRegex: 'validSourcesFor.*' ].
	self denyEmpty: methodList.
	associations := methodList collect: [ :methodName |
			                | association |
			                association := RelationSourceVerification class >> methodName asSymbol valueWithReceiver: nil arguments: #(  ).
			                self assert: association class identicalTo: Association.
			                self
				                assert: association key isClass
				                description: 'Relation source specification key must be a stereotype class'.
			                self assert: association value class identicalTo: Array.
			                association ].
	self assertCollection: (associations collect: #key) hasSameElements: self getTestedClass validSources keys
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testVerifiedClass [
	self verifiedClassTest.
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testVerifyObjectWithModel [
	self testInvalidModel.
	self testValidModel.
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testVerifySkipsAssociationWithoutStereotype [

	| collective quality association model |
	collective := self createClass: 'Team' withStereotype: OntoUMLCollective.
	quality := self createClass: 'Size' withStereotype: OntoUMLQuality.
	association := self createAssociationFrom: quality to: collective.
	model := {
		         collective.
		         quality.
		         association }.
	self assertEmpty: (RelationSourceVerification verify: association withModel: model)
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testVerifySkipsEndWithoutStereotype [

	| unstereotypedClass collective association model result |
	unstereotypedClass := OPUMLClass new.
	collective := self createClass: 'Team' withStereotype: OntoUMLCollective.
	association := self createAssociationFrom: unstereotypedClass to: collective with: OntoUMLMemberOf new.
	model := {
		         unstereotypedClass.
		         collective.
		         association }.
	result := VerificationResults new.
	result addResults: (RelationSourceVerification verify: association withModel: model).
	self assertEmpty: result results
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testVerifySubKindWithInvalidParentNoParentAndCycle [

	| kind orphanSubKind invalidParentSubKind cycleSubKindA cycleSubKindB member genToKind genCycle1 genCycle2 assocOrphan assocInvalid assocCycle model |
	kind := self createClass: 'Person' withStereotype: OntoUMLKind.
	orphanSubKind := self createClass: 'Orphan' withStereotype: OntoUMLSubKind.
	invalidParentSubKind := self createClass: 'Adult' withStereotype: OntoUMLSubKind.
	cycleSubKindA := self createClass: 'CycleA' withStereotype: OntoUMLSubKind.
	cycleSubKindB := self createClass: 'CycleB' withStereotype: OntoUMLSubKind.
	member := self createClass: 'Item' withStereotype: OntoUMLKind.
	genToKind := self createGeneralizationFor: kind withSpecific: invalidParentSubKind.
	genCycle1 := self createGeneralizationFor: cycleSubKindB withSpecific: cycleSubKindA.
	genCycle2 := self createGeneralizationFor: cycleSubKindA withSpecific: cycleSubKindB.
	assocOrphan := self createAssociationFrom: orphanSubKind to: member with: OntoUMLMemberOf new.
	assocInvalid := self createAssociationFrom: invalidParentSubKind to: member with: OntoUMLMemberOf new.
	assocCycle := self createAssociationFrom: cycleSubKindA to: member with: OntoUMLMemberOf new.
	model := {
		         kind.
		         orphanSubKind.
		         invalidParentSubKind.
		         cycleSubKindA.
		         cycleSubKindB.
		         member.
		         genToKind.
		         genCycle1.
		         genCycle2.
		         assocOrphan.
		         assocInvalid.
		         assocCycle }.
	self assert: (RelationSourceVerification verify: assocOrphan withModel: model) size equals: 1.
	self assert: (RelationSourceVerification verify: assocInvalid withModel: model) size equals: 1.
	self assert: (RelationSourceVerification verify: assocCycle withModel: model) size equals: 1
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testVerifySubKindWithValidParentAndTransitiveParent [

	| collective directSubKind nestedSubKind member directGen nestedGen directAssociation nestedAssociation model |
	collective := self createClass: 'Group' withStereotype: OntoUMLCollective.
	directSubKind := self createClass: 'Team' withStereotype: OntoUMLSubKind.
	nestedSubKind := self createClass: 'SportsTeam' withStereotype: OntoUMLSubKind.
	member := self createClass: 'Person' withStereotype: OntoUMLKind.
	directGen := self createGeneralizationFor: collective withSpecific: directSubKind.
	nestedGen := self createGeneralizationFor: directSubKind withSpecific: nestedSubKind.
	directAssociation := self createAssociationFrom: directSubKind to: member with: OntoUMLMemberOf new.
	nestedAssociation := self createAssociationFrom: nestedSubKind to: member with: OntoUMLMemberOf new.
	model := {
		         collective.
		         directSubKind.
		         nestedSubKind.
		         member.
		         directGen.
		         nestedGen.
		         directAssociation.
		         nestedAssociation }.
	self assertEmpty: (RelationSourceVerification verify: directAssociation withModel: model).
	self assertEmpty: (RelationSourceVerification verify: nestedAssociation withModel: model)
]

{ #category : 'tests' }
RelationSourceVerificationTest >> testVerifyWithModel [
	self testInvalidModel.
	self testValidModel.
]
